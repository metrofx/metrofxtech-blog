---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
}

const canonical = new URL(`/blog/${post.slug}/`, Astro.site).toString();
---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  date={post.data.date.toISOString()}
  lang={post.data.lang}
>
  <style>
    .masthead {
      background: var(--ink);
      color: var(--paper);
      text-align: center;
      padding: 12px 24px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }
    .hero {
      max-width: 720px;
      margin: 0 auto;
      padding: 48px 24px 32px;
      border-bottom: 2px solid var(--ink);
    }
    .hero-eyebrow {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 16px;
    }
    .hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2.4rem, 6vw, 3.8rem);
      font-weight: 900;
      line-height: 1.1;
      color: var(--ink);
      margin-bottom: 20px;
      letter-spacing: -0.01em;
    }
    .hero-deck {
      font-size: 1.1rem;
      font-style: italic;
      color: var(--muted);
      font-weight: 300;
      max-width: 560px;
      line-height: 1.6;
    }
    .hero-meta {
      margin-top: 24px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .hero-image {
      max-width: 720px;
      margin: 32px auto 0;
      padding: 0 24px;
    }
    .hero-image img {
      width: 100%;
      height: auto;
      border-radius: 6px;
      display: block;
    }
    .article-body {
      max-width: 720px;
      margin: 0 auto;
      padding: 40px 24px 80px;
    }
    .article-body :global(p) {
      margin-bottom: 1.4em;
    }
    .article-body :global(p:first-of-type)::first-letter {
      font-family: 'Playfair Display', serif;
      font-size: 4.2em;
      font-weight: 900;
      float: left;
      line-height: 0.75;
      margin: 6px 8px 0 0;
      padding-right: 10px;
      color: var(--accent);
    }
    .article-body :global(h2) {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--ink);
      margin: 2.8em 0 0.8em;
      border-left: 3px solid var(--accent);
      padding-left: 14px;
    }
    .article-body :global(h3) {
      font-family: 'Playfair Display', serif;
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--muted);
      margin: 2em 0 0.7em;
    }
    .article-body :global(ul), .article-body :global(ol) {
      margin-bottom: 1.4em;
      padding-left: 1.5rem;
    }
    .article-body :global(li) {
      margin-bottom: 0.7em;
    }
    .article-body :global(strong) {
      font-weight: 600;
      color: var(--ink);
    }
    .article-body :global(em) {
      font-style: italic;
      color: var(--muted);
    }
    .article-body :global(blockquote) {
      border-top: 2px solid var(--ink);
      border-bottom: 2px solid var(--ink);
      margin: 2.5em 0;
      padding: 1.4em 0;
      font-family: 'Playfair Display', serif;
      font-size: 1.3rem;
      font-style: italic;
      color: var(--ink);
      line-height: 1.5;
    }
    .article-body :global(blockquote p) {
      margin: 0;
    }
    .article-body :global(hr) {
      border: none;
      border-top: 1px solid var(--border);
      margin: 2em 0;
    }
    .article-body :global(a) {
      color: var(--accent);
      border-bottom: 1px solid var(--accent);
    }
    .article-body :global(a:hover) {
      border-bottom: none;
    }
    .article-body :global(code) {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.78em;
      background: var(--ink);
      color: #a8d5a2;
      padding: 2px 7px;
      border-radius: 3px;
    }
    .article-body :global(pre) {
      background: var(--ink);
      color: var(--paper);
      padding: 1rem;
      border-radius: 6px;
      overflow-x: auto;
      margin-bottom: 1.4em;
    }
    .article-body :global(pre code) {
      background: none;
      color: inherit;
      padding: 0;
    }
    .article-footer {
      background: var(--ink);
      color: #888;
      text-align: center;
      padding: 24px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      line-height: 1.8;
    }
    .article-footer a {
      color: #a8d5a2;
      text-decoration: none;
    }
    .article-footer a:hover {
      text-decoration: underline;
    }
    .source-link {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 24px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--muted);
      text-align: center;
      margin-bottom: 2rem;
    }
    .source-link a {
      color: var(--accent);
      border-bottom: 1px solid var(--accent);
    }
    .source-link a:hover {
      border-bottom: none;
    }
    .back-link {
      display: inline-block;
      margin-bottom: 8px;
      font-size: 11px;
      color: var(--muted);
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .back-link:hover {
      color: var(--accent);
    }
    @media (max-width: 600px) {
      body { font-size: 16px; }
      .hero { padding: 32px 16px 24px; }
      .article-body { padding: 28px 16px 60px; }
      .article-body :global(p:first-of-type)::first-letter {
        font-size: 3.6em;
        padding-right: 8px;
      }
      .article-body :global(blockquote) {
        font-size: 1.15rem;
        padding: 1em 0;
      }
    }
  </style>

  <div class="masthead">Teknologi, AI & Geopolitik</div>

  <article>
    <header class="hero">
      <div class="hero-eyebrow">Artikel</div>
      <h1>{post.data.title}</h1>
      <p class="hero-deck">{post.data.description}</p>
      <div class="hero-meta">{formatDate(post.data.date)}</div>
    </header>

    {post.data.image && (
      <div class="hero-image">
        <img src={post.data.image} alt={post.data.title} loading="lazy" />
      </div>
    )}

    {post.data.source && (
      <div class="source-link">
        Sumber: <a href={post.data.source} target="_blank" rel="noopener">{post.data.sourceTitle || post.data.source}</a>
      </div>
    )}

    <div class="article-body">
      <Content />
    </div>

    <footer class="article-footer">
      <a href="/" class="back-link">← Kembali ke beranda</a>
      <p>metrofxtech — blog yang diotomasi dengan Hermes Agent</p>
    </footer>
  </article>
</Layout>
