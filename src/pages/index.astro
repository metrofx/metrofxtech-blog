---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
}
---

<Layout title="metrofxtech — Blog teknologi, AI, dan geopolitik" description="Kumpulan artikel teknologi, AI, dan geopolitik dalam Bahasa Indonesia." type="website">
  <style>
    .masthead {
      background: var(--ink);
      color: var(--paper);
      text-align: center;
      padding: 12px 24px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }
    .hero {
      max-width: 720px;
      margin: 0 auto;
      padding: 48px 24px 32px;
      border-bottom: 2px solid var(--ink);
    }
    .hero-eyebrow {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 16px;
    }
    .hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2.4rem, 6vw, 3.8rem);
      font-weight: 900;
      line-height: 1.1;
      color: var(--ink);
      margin-bottom: 20px;
      letter-spacing: -0.01em;
    }
    .hero-deck {
      font-size: 1.1rem;
      font-style: italic;
      color: var(--muted);
      font-weight: 300;
      max-width: 560px;
      line-height: 1.6;
    }
    .post-list {
      max-width: 720px;
      margin: 0 auto;
      padding: 40px 24px 80px;
      list-style: none;
    }
    .post-item {
      padding: 2rem 0;
      border-bottom: 1px solid var(--border);
    }
    .post-item:first-child { padding-top: 0; }
    .post-item:last-child { border-bottom: none; }
    .post-meta {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.5rem;
    }
    .post-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem;
      font-weight: 700;
      line-height: 1.3;
      color: var(--ink);
      margin-bottom: 0.5rem;
    }
    .post-title a { color: inherit; }
    .post-title a:hover { color: var(--accent); text-decoration: none; }
    .post-desc {
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.6;
    }
    .post-tags {
      margin-top: 0.75rem;
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .post-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--accent);
      border: 1px solid var(--border);
      padding: 4px 10px;
      border-radius: 4px;
    }
    .footer {
      background: var(--ink);
      color: #888;
      text-align: center;
      padding: 24px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      line-height: 1.8;
    }
    .footer a {
      color: #a8d5a2;
      text-decoration: none;
    }
    .footer a:hover {
      text-decoration: underline;
    }
    @media (max-width: 600px) {
      body { font-size: 16px; }
      .hero { padding: 32px 16px 24px; }
      .post-list { padding: 28px 16px 60px; }
    }
  </style>

  <div class="masthead">Teknologi, AI & Geopolitik</div>

  <header class="hero">
    <div class="hero-eyebrow">Blog</div>
    <h1>metrofxtech</h1>
    <p class="hero-deck">Kumpulan artikel teknologi, AI, dan geopolitik dalam Bahasa Indonesia. Ditulis bebas dari berbagai sumber.</p>
  </header>

  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-item">
        <div class="post-meta">{formatDate(post.data.date)}</div>
        <h2 class="post-title">
          <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
        </h2>
        <p class="post-desc">{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((tag) => (
              <span class="post-tag">{tag}</span>
            ))}
          </div>
        )}
      </li>
    ))}
  </ul>

  <footer class="footer">
    <p>metrofxtech — blog yang diotomasi dengan Hermes Agent</p>
  </footer>
</Layout>
